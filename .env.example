# Copy this file to .env and replace every replace-me value before starting Compose.
# These placeholders are intentionally invalid and are not usable credentials.

API_HOST_PORT=8080
SQL_HOST_PORT=1433
ASPNETCORE_ENVIRONMENT=Development

SQL_SA_PASSWORD=replace-me
DATABASE_CONNECTION_STRING=Server=sql,1433;Database=EnterpriseIdentityService;User ID=sa;Password=replace-me;Encrypt=True;TrustServerCertificate=True

JWT_ISSUER=EnterpriseIdentityService
JWT_AUDIENCE=EnterpriseIdentityService.Client
JWT_SIGNING_KEY=replace-me
JWT_EXPIRATION_MINUTES=15

AUTHENTICATION_SESSION_LIFETIME=30.00:00:00
PASSWORD_RECOVERY_TOKEN_LIFETIME=00:30:00
PASSWORD_RECOVERY_REQUEST_COOLDOWN=00:01:00
PASSWORD_RECOVERY_PUBLIC_BASE_URL=https://localhost
EMAIL_VERIFICATION_TOKEN_LIFETIME=1.00:00:00
EMAIL_VERIFICATION_RESEND_COOLDOWN=00:01:00
EMAIL_VERIFICATION_PUBLIC_BASE_URL=https://localhost

RESEND_ENABLED=false
RESEND_API_KEY=your-api-key-here
RESEND_FROM_ADDRESS=onboarding@example.invalid
RESEND_FROM_NAME="Enterprise Identity Service"
