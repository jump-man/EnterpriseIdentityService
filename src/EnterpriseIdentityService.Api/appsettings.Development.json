{
  "ConnectionStrings": {
    "Database": "Server=localhost;Database=EnterpriseIdentityService;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "EnterpriseIdentityService",
    "Audience": "EnterpriseIdentityService.Client",
    "SigningKey": "development-only-signing-key-change-with-user-secrets",
    "ExpirationMinutes": 15
  },
  "EmailVerification": {
    "TokenLifetime": "1.00:00:00",
    "ResendCooldown": "00:01:00",
    "PublicBaseUrl": "https://localhost:5001"
  },
  "Resend": {
    "Enabled": true,
    "ApiKey": "",
    "FromAddress": "onboarding@resend.dev",
    "FromName": "Enterprise Identity Service"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
